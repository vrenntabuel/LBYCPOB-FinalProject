<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.FocusController"
            prefWidth="600.0"
            prefHeight="700.0"
            style="-fx-background-color: #FFF8E7;">

    <!-- Navigation Bar -->
    <fx:include source="navigation.fxml"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <!-- Focus Timer Content -->
    <VBox alignment="TOP_CENTER"
          spacing="20.0"
          AnchorPane.topAnchor="80.0"
          AnchorPane.bottomAnchor="30.0"
          AnchorPane.leftAnchor="40.0"
          AnchorPane.rightAnchor="40.0">

        <!-- Title -->
        <Label text="Focus Timer"
               style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <!-- Timer Mode Buttons -->
        <HBox alignment="CENTER"
              spacing="10.0">

            <Button text="Pomodoro"
                    onAction="#handlePomodoro"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Button text="Custom"
                    onAction="#handleCustom"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Button text="Short Break"
                    onAction="#handleShortBreak"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

        </HBox>

        <!-- Timer Area -->
        <VBox alignment="CENTER"
              spacing="15.0"
              prefHeight="300.0"
              style="-fx-border-color: #756F63;
                     -fx-border-width: 1;
                     -fx-background-color: #FFFDF7;">

            <Label fx:id="durationLabel"
                   text="25 minutes"
                   style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

            <Label fx:id="actualTimerLabel"
                   text="25:00"
                   style="-fx-font-size: 64px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

            <!-- Custom Duration -->
            <HBox spacing="10.0"
                  alignment="CENTER">

                <Spinner fx:id="minutesSpinner"
                         editable="true"
                         prefWidth="90.0"
                         visible="false"
                         managed="false"
                         onMouseReleased="#handleMinutesChanged" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-radius: 7; -fx-background-radius: 7;"/>

                <Label fx:id="customSeparator"
                       text=":"
                       visible="false"
                       managed="false"
                       style="-fx-font-size: 24px;; -fx-text-fill: #29251D;"/>

                <Spinner fx:id="secondsSpinner"
                         editable="true"
                         prefWidth="90.0"
                         visible="false"
                         managed="false"
                         onMouseReleased="#handleSecondsChanged" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-radius: 7; -fx-background-radius: 7;"/>

            </HBox>

        </VBox>

        <!-- Control Buttons -->
        <HBox alignment="CENTER"
              spacing="15.0">

            <Button text="Reset"
                    onAction="#handleReset"
                    prefWidth="100.0"
                    prefHeight="50.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="startPauseButton"
                    text="▶ / II"
                    onAction="#handleStartPause"
                    prefWidth="120.0"
                    prefHeight="50.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Button text="Skip"
                    onAction="#handleSkip"
                    prefWidth="100.0"
                    prefHeight="50.0"
                    style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

        </HBox>

    </VBox>

</AnchorPane>