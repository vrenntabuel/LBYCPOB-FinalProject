<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.DashboardController"
            prefWidth="1000.0"
            prefHeight="700.0">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="EarlyBird"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Your productivity dashboard"
                   style="-fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="15">

            <Label text="Welcome to your Dashboard"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Your tasks, calendar, and deadline risks will appear here."/>

        </VBox>
    </center>

</BorderPane>