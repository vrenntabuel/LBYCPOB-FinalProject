<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.TaskBreakdownController"
        prefHeight="700.0"
        prefWidth="1000.0" style="-fx-background-color: #FFF8E7;">

    <VBox
            spacing="18.0"
            AnchorPane.topAnchor="40.0"
            AnchorPane.rightAnchor="40.0"
            AnchorPane.bottomAnchor="40.0"
            AnchorPane.leftAnchor="40.0">

        <Label
                text="EarlyBird"
                style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <Label
                text="Task Breakdown"
                style="-fx-font-size: 24px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <Label
                fx:id="assignmentTitleLabel"
                style="-fx-font-size: 20px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <Label
                fx:id="progressLabel"
                text="Progress: 0 / 0"
                style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

        <ScrollPane
                fitToWidth="true"
                VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <content>

                <VBox
                        fx:id="subtaskContainer"
                        spacing="12.0"
                        style="-fx-padding: 10;"/>

            </content>

        </ScrollPane>

        <Button
                text="+ Add Subtask"
                onAction="#handleAddSubtask"
                prefWidth="160.0"
                prefHeight="40.0" style="-fx-background-color: #F4C542; -fx-text-fill: #29251D; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

        <Button
                text="Back to Assignment"
                onAction="#handleBack"
                prefWidth="180.0"
                prefHeight="40.0" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

    </VBox>

</AnchorPane>