      xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER"
      spacing="20"
      prefHeight="700"
      prefWidth="1000" style="-fx-background-color: #FFF8E7;">

    <Label text="Welcome to EarlyBird"
           style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

