<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AssignmentDetailsController"
            prefWidth="1000.0"
            prefHeight="700.0">

    <VBox spacing="20.0"
          AnchorPane.topAnchor="40.0"
          AnchorPane.rightAnchor="40.0"
          AnchorPane.bottomAnchor="40.0"
          AnchorPane.leftAnchor="40.0">

        <Label text="EarlyBird"
               style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

        <Label text="Assignment Details"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <VBox spacing="12.0"
              style="-fx-border-color: #d9d9d9;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;
                     -fx-padding: 20;">

            <Label text="Database Project"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Due Friday"
                   style="-fx-font-size: 16px;"/>

            <Label text="Priority: High"
                   style="-fx-font-size: 16px;"/>

            <Label text="Design and implement the database schema."
                   style="-fx-font-size: 16px;"/>

        </VBox>

        <Button text="Back to Assignments"
                onAction="#handleBack"
                prefWidth="160.0"
                prefHeight="40.0"/>

    </VBox>

</AnchorPane>