<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AssignmentDetailsController"
        prefWidth="1000.0"
        prefHeight="700.0" style="-fx-background-color: #FFF8E7;">

    <VBox
            spacing="18.0"
            AnchorPane.topAnchor="40.0"
            AnchorPane.rightAnchor="40.0"
            AnchorPane.bottomAnchor="40.0"
            AnchorPane.leftAnchor="40.0">

        <Label
                text="EarlyBird"
                style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <Label
                text="Assignment Details"
                style="-fx-font-size: 24px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

        <VBox
                spacing="10.0"
                style="-fx-border-color: #E5D6B3;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-padding: 20;">

            <Label
                    fx:id="titleLabel"
                    style="-fx-font-size: 22px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

            <Label
                    fx:id="subjectLabel"
                    style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

            <Label
                    fx:id="dueDateLabel"
                    style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

            <Label
                    fx:id="durationLabel"
                    style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

            <Label
                    fx:id="priorityLabel"
                    style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

            <Label
                    fx:id="descriptionLabel"
                    wrapText="true"
                    style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>

        </VBox>

        <CheckBox
                fx:id="completedCheckBox"
                text="Mark Assignment as Complete"
                onAction="#handleCompletionChanged"
                style="-fx-text-fill: #29251D; -fx-font-size: 16px;"/>

        <Button
                text="Task Breakdown"
                onAction="#handleTaskBreakdown"
                prefWidth="180.0"
                prefHeight="40.0" style="-fx-background-color: #F4C542; -fx-text-fill: #29251D; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

        <Button
                text="Back to Assignments"
                onAction="#handleBack"
                prefWidth="180.0"
                prefHeight="40.0" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

    </VBox>

</AnchorPane>