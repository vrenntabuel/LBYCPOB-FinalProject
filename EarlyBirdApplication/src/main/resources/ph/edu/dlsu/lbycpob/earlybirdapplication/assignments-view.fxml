<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AssignmentController"
            prefHeight="700.0"
            prefWidth="1000.0">

    <VBox spacing="25.0"
          AnchorPane.topAnchor="40.0"
          AnchorPane.rightAnchor="40.0"
          AnchorPane.bottomAnchor="40.0"
          AnchorPane.leftAnchor="40.0">

        <!-- Header -->
        <VBox spacing="8.0">

            <Label text="EarlyBird"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

            <Label text="Assignments"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Your upcoming assignments"
                   style="-fx-font-size: 16px;"/>

        </VBox>

        <!-- Assignment Cards -->
        <VBox spacing="15.0">

            <!-- Assignment 1 -->
            <VBox spacing="8.0"
                  style="-fx-border-color: #d9d9d9;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="10.0">

                    <Label text="Database Project"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="Due Friday"
                           style="-fx-font-size: 14px;"/>

                </HBox>

                <Label text="Design and implement the database schema."
                       style="-fx-font-size: 14px;"/>

                <HBox spacing="15.0">

                    <Label text="Priority: High"
                           style="-fx-font-size: 14px;"/>

                    <Button text="View"
                            prefWidth="90.0"
                            prefHeight="30.0"/>

                </HBox>

            </VBox>


            <!-- Assignment 2 -->
            <VBox spacing="8.0"
                  style="-fx-border-color: #d9d9d9;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="10.0">

                    <Label text="JavaFX Application"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="Due Monday"
                           style="-fx-font-size: 14px;"/>

                </HBox>

                <Label text="Complete the application interface."
                       style="-fx-font-size: 14px;"/>

                <HBox spacing="15.0">

                    <Label text="Priority: Medium"
                           style="-fx-font-size: 14px;"/>

                    <Button text="View"
                            prefWidth="90.0"
                            prefHeight="30.0"/>

                </HBox>

            </VBox>


            <!-- Assignment 3 -->
            <VBox spacing="8.0"
                  style="-fx-border-color: #d9d9d9;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 18;">

                <HBox spacing="10.0">

                    <Label text="Research Paper"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="Due Friday"
                           style="-fx-font-size: 14px;"/>

                </HBox>

                <Label text="Submit the first draft of the research paper."
                       style="-fx-font-size: 14px;"/>

                <HBox spacing="15.0">

                    <Label text="Priority: Low"
                           style="-fx-font-size: 14px;"/>

                    <Button text="View"
                            prefWidth="90.0"
                            prefHeight="30.0"/>

                </HBox>

            </VBox>

        </VBox>

    </VBox>

</AnchorPane>