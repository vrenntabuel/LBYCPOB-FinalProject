<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AssignmentController"
        prefWidth="1000.0"
        prefHeight="700.0">

    <VBox
            spacing="20"
            AnchorPane.topAnchor="0"
            AnchorPane.rightAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0">

        <!-- NAVIGATION -->

        <fx:include source="navigation.fxml"/>

        <!-- ASSIGNMENT CONTENT -->

        <VBox
                spacing="20"
                VBox.vgrow="ALWAYS"
                AnchorPane.leftAnchor="40"
                AnchorPane.rightAnchor="40">

            <padding>
                <Insets
                        top="20"
                        right="40"
                        bottom="20"
                        left="40"/>
            </padding>

            <Label
                    text="EarlyBird"
                    style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

            <Label
                    text="My Assignments"
                    style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Button
                    text="+ Add Assignment"
                    onAction="#handleAddAssignment"
                    prefWidth="180"
                    prefHeight="40"/>

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS">

                <content>

                    <VBox
                            fx:id="assignmentContainer"
                            spacing="15">

                        <padding>
                            <Insets
                                    top="5"
                                    right="5"
                                    bottom="5"
                                    left="5"/>
                        </padding>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </VBox>

</AnchorPane>