<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AssignmentController"
            prefHeight="700.0"
            prefWidth="1000.0">

    <!-- Assignment Content -->
    <VBox spacing="20"
          AnchorPane.topAnchor="35"
          AnchorPane.rightAnchor="40"
          AnchorPane.bottomAnchor="100"
          AnchorPane.leftAnchor="40">

        <Label text="EarlyBird"
               style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

        <Label text="My Assignments"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

        <Button text="+ Add Assignment"
                onAction="#handleAddAssignment"
                prefWidth="180"
                prefHeight="40"/>

        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS">

            <content>

                <VBox fx:id="assignmentContainer"
                      spacing="15">

                    <padding>
                        <Insets top="5"
                                right="5"
                                bottom="5"
                                left="5"/>
                    </padding>

                </VBox>

            </content>

        </ScrollPane>

    </VBox>

    <!-- Global Navigation -->
    <fx:include source="navigation.fxml"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                AnchorPane.bottomAnchor="0"/>

</AnchorPane>