<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.CanvasLinkController"
            prefWidth="1000"
            prefHeight="700"
            style="-fx-background-color: #FFF8E7;">


    <!-- CANVAS CONTENT -->
    <center>

        <VBox alignment="TOP_CENTER"
              spacing="20"
              maxWidth="820">

            <padding>
                <Insets top="55"
                        right="40"
                        bottom="40"
                        left="40"/>
            </padding>

            <Label text="Link Canvas LMS Calendar"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

            <Label text="Connect your Canvas calendar to automatically bring your assignments into EarlyBird."
                   wrapText="true"
                   style="-fx-font-size: 17px;; -fx-text-fill: #29251D;"/>


            <VBox spacing="8"
                  maxWidth="820">

                <Label text="How to get your Canvas Calendar Link"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

                <Label text="1. Open Canvas LMS&#10;2. Open Calendar&#10;3. Find the Calendar Feed option&#10;4. Copy your Canvas calendar URL"
                       style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"
                       wrapText="true"/>

            </VBox>


            <VBox spacing="8"
                  maxWidth="820">

                <Label text="Canvas Calendar Link"
                       style="-fx-font-weight: bold; -fx-font-size: 15px;; -fx-text-fill: #29251D;"/>

                <TextField fx:id="canvasLinkField"
                           promptText="Paste your Canvas calendar URL here"
                           prefHeight="45" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-radius: 7; -fx-background-radius: 7;"/>

            </VBox>


            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 16px;; -fx-text-fill: #29251D;"/>


            <HBox alignment="CENTER"
                  spacing="15">

                <Button text="Connect Canvas"
                        onAction="#handleConnectCanvas"
                        prefWidth="225"
                        prefHeight="50" style="-fx-background-color: #F4C542; -fx-text-fill: #29251D; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

                <Button text="Continue Without Canvas"
                        onAction="#handleContinueWithoutCanvas"
                        prefWidth="220"
                        prefHeight="45" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>