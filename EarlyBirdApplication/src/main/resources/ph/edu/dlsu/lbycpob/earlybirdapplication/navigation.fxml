<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.NavigationController"
        spacing="10"
        alignment="CENTER_LEFT"
        prefHeight="60.0"
        style="-fx-background-color: #1f1f1f; -fx-padding: 15;">

    <Button
            text="Home"
            onAction="#goHome"/>

    <Button
            text="Assignments"
            onAction="#goAssignments"/>

    <Button
            text="Calendar"
            onAction="#goCalendar"/>

    <Button
            text="Focus Timer"
            onAction="#goFocus"/>

    <Button
            text="Dashboard"
            onAction="#goDashboard"/>

</HBox>