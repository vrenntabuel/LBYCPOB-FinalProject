<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.NavigationController"
      alignment="CENTER"
      spacing="10"
      prefHeight="65"
      style="-fx-background-color: white;
             -fx-border-color: #dddddd;
             -fx-border-width: 1 0 0 0;">

    <Button text="Home"
            onAction="#handleHome"
            prefWidth="100"
            prefHeight="45"/>

    <Button text="Assignments"
            onAction="#handleAssignments"
            prefWidth="120"
            prefHeight="45"/>

    <Button text="Calendar"
            onAction="#handleCalendar"
            prefWidth="100"
            prefHeight="45"/>

    <Button text="Focus Timer"
            onAction="#handleFocusTimer"
            prefWidth="110"
            prefHeight="45"/>

    <Button text="Dashboard"
            onAction="#handleDashboard"
            prefWidth="110"
            prefHeight="45"/>

</HBox>