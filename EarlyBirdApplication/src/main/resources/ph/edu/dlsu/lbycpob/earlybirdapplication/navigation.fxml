<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.NavigationController"
        spacing="10"
        alignment="CENTER_LEFT"
        prefHeight="60.0"
        style="-fx-background-color: #29251D; -fx-padding: 15;">

    <Button
            text="Home"
            onAction="#goHome" style="-fx-background-color: transparent; -fx-text-fill: #FFFDF7; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

    <Button
            text="Assignments"
            onAction="#goAssignments" style="-fx-background-color: transparent; -fx-text-fill: #FFFDF7; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

    <Button
            text="Calendar"
            onAction="#goCalendar" style="-fx-background-color: transparent; -fx-text-fill: #FFFDF7; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

    <Button
            text="Focus Timer"
            onAction="#goFocus" style="-fx-background-color: transparent; -fx-text-fill: #FFFDF7; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

    <Button
            text="Dashboard"
            onAction="#goDashboard" style="-fx-background-color: transparent; -fx-text-fill: #FFFDF7; -fx-border-color: transparent; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

</HBox>