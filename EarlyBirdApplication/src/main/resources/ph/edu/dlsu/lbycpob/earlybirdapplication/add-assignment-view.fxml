<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AddAssignmentController"
        prefWidth="1000.0"
        prefHeight="700.0">

    <!-- NAVIGATION -->

    <fx:include source="navigation.fxml"/>

    <!-- CONTENT -->

    <VBox
            spacing="12"
            VBox.vgrow="ALWAYS">

        <padding>
            <Insets
                    top="30"
                    right="50"
                    bottom="30"
                    left="50"/>
        </padding>

        <Label
                text="New Assignment"
                style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

        <Label text="Title"/>

        <TextField
                fx:id="titleField"
                promptText="Enter assignment title"/>

        <Label text="Subject"/>

        <TextField
                fx:id="subjectField"
                promptText="Enter subject"/>

        <Label text="Due Date"/>

        <DatePicker
                fx:id="dueDatePicker"/>

        <Label text="Estimated Duration"/>

        <TextField
                fx:id="durationField"
                promptText="Hours"/>

        <Label text="Priority"/>

        <ComboBox
                fx:id="priorityComboBox"
                promptText="Select priority"
                prefWidth="160"/>

        <Label text="Description (optional)"/>

        <TextArea
                fx:id="descriptionField"
                promptText="Enter description"
                prefHeight="100"/>

        <HBox spacing="15">

            <Button
                    text="Add Assignment"
                    onAction="#handleAddAssignment"
                    prefWidth="180"
                    prefHeight="45"/>

            <Button
                    text="Cancel"
                    onAction="#handleCancel"
                    prefWidth="120"
                    prefHeight="45"/>

        </HBox>

    </VBox>

</VBox>