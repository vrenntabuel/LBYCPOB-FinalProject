<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.AddAssignmentController"
      spacing="12"
      prefWidth="1000"
      prefHeight="700"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="35" right="50" bottom="35" left="50"/>
    </padding>

    <Label text="New Assignment"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="Title"/>
    <TextField fx:id="titleField"
               promptText="Enter assignment title"/>

    <Label text="Subject"/>
    <TextField fx:id="subjectField"
               promptText="Enter subject"/>

    <Label text="Due Date"/>
    <DatePicker fx:id="dueDatePicker"/>

    <Label text="Estimated Duration"/>
    <TextField fx:id="durationField"
               promptText="Hours"/>

    <Label text="Priority"/>
    <ComboBox fx:id="priorityBox"
              promptText="Select priority"/>

    <Label text="Description (optional)"/>
    <TextArea fx:id="descriptionField"
              promptText="Enter description"
              prefRowCount="3"/>

    <Button text="Add Assignment"
            onAction="#handleAddAssignment"
            prefWidth="180"
            prefHeight="40"/>

</VBox>