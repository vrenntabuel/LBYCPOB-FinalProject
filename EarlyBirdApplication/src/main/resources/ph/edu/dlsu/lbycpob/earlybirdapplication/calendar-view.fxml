<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.CalendarController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <content>

        <VBox spacing="20"
              fillWidth="true">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <!-- HEADER -->

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Label text="Calendar View"
                       style="-fx-font-size: 28px;
                              -fx-font-weight: bold;"/>

                <Button text="Month"
                        onAction="#showMonthView"
                        prefWidth="90"/>

                <Button text="Week"
                        onAction="#showWeekView"
                        prefWidth="90"/>

            </HBox>

            <!-- DATE NAVIGATION -->

            <HBox alignment="CENTER"
                  spacing="25">

                <Button text="‹"
                        onAction="#handlePrevious"
                        prefWidth="45"
                        prefHeight="35"/>

                <Label fx:id="dateRangeLabel"
                       text="August 2026"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                <Button text="›"
                        onAction="#handleNext"
                        prefWidth="45"
                        prefHeight="35"/>

            </HBox>

            <!-- MONTH -->

            <VBox fx:id="monthView"
                  spacing="5">

                <GridPane fx:id="monthGrid"
                          hgap="5"
                          vgap="5"
                          prefHeight="500"
                          minHeight="500">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>

                    </columnConstraints>

                </GridPane>

            </VBox>

            <!-- WEEK -->

            <VBox fx:id="weekView"
                  spacing="5"
                  visible="false"
                  managed="false">

                <GridPane fx:id="weekGrid"
                          hgap="5"
                          vgap="5"
                          prefHeight="450"
                          minHeight="450">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>

                    </columnConstraints>

                </GridPane>

            </VBox>

            <!-- RISK -->

            <VBox spacing="10">

                <Label text="Deadline Risk Indicator"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <VBox fx:id="riskContainer"
                      spacing="10"
                      prefHeight="250"
                      minHeight="150"/>

            </VBox>

        </VBox>

    </content>

</ScrollPane>