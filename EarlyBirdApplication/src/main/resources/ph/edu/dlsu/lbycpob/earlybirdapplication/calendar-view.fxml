<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.CalendarController"
            prefWidth="1000"
            prefHeight="700"
            style="-fx-background-color: white;">

    <top>
        <VBox spacing="15">
            <padding>
                <Insets top="30" right="40" bottom="15" left="40"/>
            </padding>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Calendar View"
                       style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                <HBox spacing="5">
                    <Button text="Month"
                            onAction="#showMonthView"
                            prefWidth="100"/>

                    <Button text="Week"
                            onAction="#showWeekView"
                            prefWidth="100"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER" spacing="25">

                <Button text="‹"
                        onAction="#handlePrevious"
                        prefWidth="45"
                        prefHeight="35"/>

                <Label fx:id="dateRangeLabel"
                       text="May 2025"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <Button text="›"
                        onAction="#handleNext"
                        prefWidth="45"
                        prefHeight="35"/>

            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="40" bottom="10" left="40"/>
            </padding>

            <!-- MONTH VIEW -->
            <VBox fx:id="monthView"
                  spacing="10"
                  VBox.vgrow="ALWAYS">

                <GridPane fx:id="monthGrid"
                          hgap="5"
                          vgap="5"
                          prefHeight="390"
                          minHeight="390"
                          maxHeight="390"/>
            </VBox>

            <!-- WEEK VIEW -->
            <VBox fx:id="weekView"
                  spacing="10"
                  VBox.vgrow="ALWAYS"
                  visible="false"
                  managed="false">

                <GridPane fx:id="weekGrid"
                          hgap="5"
                          vgap="5"
                          prefHeight="390"
                          minHeight="390"
                          maxHeight="390"/>
            </VBox>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="40" bottom="25" left="40"/>
            </padding>

            <Label text="Deadline Risk Indicator"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <HBox spacing="15"
                  style="-fx-background-color: #f3f3f3;
                         -fx-background-radius: 10;
                         -fx-padding: 15;">

                <Label text="Research Paper"
                       style="-fx-font-weight: bold;"/>

                <Label text="Due in 5 days"/>

                <Label text="Medium Risk"
                       style="-fx-font-weight: bold;"/>

            </HBox>
        </VBox>
    </bottom>

</BorderPane>