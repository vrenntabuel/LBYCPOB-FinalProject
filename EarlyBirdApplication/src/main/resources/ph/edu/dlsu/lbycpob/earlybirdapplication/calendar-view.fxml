<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ph.edu.dlsu.lbycpob.earlybirdapplication.controller.CalendarController"
        prefWidth="1000.0"
        prefHeight="700.0" style="-fx-background-color: #FFF8E7;">

    <VBox
            spacing="20"
            AnchorPane.topAnchor="0"
            AnchorPane.rightAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0">

        <!-- SAME NAVIGATION AS ASSIGNMENTS -->

        <fx:include source="navigation.fxml"/>


        <!-- CALENDAR CONTENT -->

        <VBox
                spacing="20"
                VBox.vgrow="ALWAYS">

            <padding>
                <Insets
                        top="20"
                        right="40"
                        bottom="20"
                        left="40"/>
            </padding>


            <!-- HEADER -->

            <HBox
                    spacing="20"
                    alignment="CENTER_LEFT">

                <Label
                        text="Calendar View"
                        style="-fx-font-size: 32px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

                <Button
                        text="Month"
                        onAction="#showMonthView"
                        prefWidth="90"
                        prefHeight="35" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

                <Button
                        text="Week"
                        onAction="#showWeekView"
                        prefWidth="90"
                        prefHeight="35" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            </HBox>


            <!-- DATE NAVIGATION -->

            <HBox
                    alignment="CENTER"
                    spacing="25">

                <Button
                        text="‹"
                        onAction="#handlePrevious"
                        prefWidth="45"
                        prefHeight="35" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

                <Label
                        fx:id="dateRangeLabel"
                        text="August 2026"
                        style="-fx-font-size: 24px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>

                <Button
                        text="›"
                        onAction="#handleNext"
                        prefWidth="45"
                        prefHeight="35" style="-fx-background-color: #FFFDF7; -fx-text-fill: #29251D; -fx-border-color: #E5D6B3; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>

            </HBox>


            <!-- SCROLLABLE CALENDAR AREA -->

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-border-color: transparent;">

                <content>

                    <VBox
                            spacing="20"
                            fillWidth="true">


                        <!-- MONTH VIEW -->

                        <VBox
                                fx:id="monthView"
                                spacing="5">

                            <GridPane
                                    fx:id="monthGrid"
                                    hgap="5"
                                    vgap="5"
                                    prefHeight="525"
                                    minHeight="525">

                                <columnConstraints>

                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>

                                </columnConstraints>

                            </GridPane>

                        </VBox>


                        <!-- WEEK VIEW -->

                        <VBox
                                fx:id="weekView"
                                spacing="5"
                                visible="false"
                                managed="false">

                            <GridPane
                                    fx:id="weekGrid"
                                    hgap="5"
                                    vgap="5"
                                    prefHeight="450"
                                    minHeight="450">

                                <columnConstraints>

                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>
                                    <ColumnConstraints percentWidth="14.2857"/>

                                </columnConstraints>

                            </GridPane>

                        </VBox>


                        <!-- DEADLINE RISK -->

                        <VBox
                                spacing="10">

                            <Label
                                    text="Deadline Risk Indicator"
                                    style="-fx-font-size: 20px; -fx-font-weight: bold;; -fx-text-fill: #29251D;"/>


                            <!-- INDEPENDENT RISK SCROLL -->

                            <ScrollPane
                                    fitToWidth="true"
                                    prefHeight="250"
                                    minHeight="200"
                                    maxHeight="250"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-border-color: transparent;">

                                <content>

                                    <VBox
                                            fx:id="riskContainer"
                                            spacing="10">

                                        <padding>
                                            <Insets
                                                    top="5"
                                                    right="5"
                                                    bottom="5"
                                                    left="5"/>
                                        </padding>

                                    </VBox>

                                </content>

                            </ScrollPane>

                        </VBox>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </VBox>

</AnchorPane>